# Django secret key. Generate a new one for production.
DJANGO_SECRET_KEY=

# Set to True only on a development machine.
DJANGO_DEBUG=False

# Comma-separated list, no spaces. Required when DJANGO_DEBUG is False.
DJANGO_ALLOWED_HOSTS=

# PostgreSQL configuration
POSTGRES_USER=your-user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medication_log
# Single-line database address.
DATABASE_URL=postgres://your-user:change-me@localhost:5434/medication_log
